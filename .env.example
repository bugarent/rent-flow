# ── Core (required in production) ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rentairportcars"
NEXTAUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
NEXTAUTH_URL="https://rentairportcars.com"
NEXT_PUBLIC_SITE_URL="https://rentairportcars.com"

# ── Persistent files (Cloudways) ────────────────────────────────────────────
# Keep these OUTSIDE the app folder so a deploy does not delete saved data.
# The start script defaults to $HOME/rentairportcars-persist/{data,uploads}.
# On Vercel do NOT set DATA_DIR=data (that becomes read-only /var/task/data).
# JSON stores also persist in Postgres table JsonStore.
# DATA_DIR="/home/master/rentairportcars-persist/data"
# UPLOAD_DIR="/home/master/rentairportcars-persist/uploads"
# PORT is set by Cloudways. Start command: bash scripts/cloudways-start.sh

# ── Telegram (@rentairportcarsbot) — booking + live-chat alerts ─────────────
# 1) Create the bot with BotFather and paste the token here (or Admin → Settings).
# 2) Open https://t.me/rentairportcarsbot and tap Start (or /start ADMIN) so the
#    site can remember your chat id for booking notifications.
# 3) Optionally set Admin Telegram Chat ID in Admin → Settings.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="rentairportcarsbot"
# Optional: Telegram setWebhook secret_token (must match header on /api/telegram/webhook)
TELEGRAM_WEBHOOK_SECRET=""
# Optional: protect POST /api/telegram/setup-webhook
TELEGRAM_SETUP_SECRET=""

# ── Cron workers (required in production) ───────────────────────────────────
CRON_SECRET="replace-with-a-long-random-cron-secret"
# Optional aliases:
# INTEGRATIONS_CRON_SECRET=""
# FX_CRON_SECRET=""

# ── Live chat (optional — without it, chat answers from site knowledge / FAQ)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RentAirportCars <noreply@rentairportcars.com>"

# ── Google Places (homepage reviews carousel). Enable Places API on the key.
# GOOGLE_PLACES_API_KEY=""

# ── PayPal Business (default sandbox — no live charges) ─────────────────────
# For live deposits: PAYPAL_MODE="live" + live Client ID/Secret from PayPal Developer.
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# ── Optional public contact overrides ───────────────────────────────────────
# NEXT_PUBLIC_SUPPORT_EMAIL="info@rentairportcars.com"
# NEXT_PUBLIC_WHATSAPP_NUMBER="995555000000"

# ── Pre-launch checklist (manual) ───────────────────────────────────────────
# [ ] DATABASE_URL points at production Postgres
# [ ] NEXTAUTH_SECRET is unique (≥32 chars) and not committed
# [ ] NEXTAUTH_URL + NEXT_PUBLIC_SITE_URL are https://rentairportcars.com
# [ ] TELEGRAM_BOT_TOKEN set; admin started the bot; chat id stored
# [ ] CRON_SECRET set; cron hits /api/... with Authorization header
# [ ] PAYPAL_MODE=live only when ready; sandbox for staging
# [ ] SMTP_* configured for booking emails
# [ ] npm run build succeeds; GET /api/health returns {"ok":true}
